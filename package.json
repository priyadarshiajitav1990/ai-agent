{
  "name": "gemini-ai-agent",
  "version": "1.0.0",
  "description": "AI Agent using Google Gemini API for code assistance - with VS Code extension integration",
  "main": "dist/index.js",
  "type": "module",
  "extensionMain": "dist/extension.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test dist/**/*.test.js",
    "extension:compile": "tsc -p ./tsconfig.extension.json",
    "extension:watch": "tsc -watch -p ./tsconfig.extension.json",
    "extension:package": "vsce package",
    "extension:publish": "vsce publish"
  },
  "keywords": [
    "ai-agent",
    "gemini",
    "code-assist",
    "chat",
    "vscode",
    "extension",
    "error-fixing",
    "offline"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.3.0",
    "@octokit/rest": "^19.0.13",
    "dotenv": "^16.0.0",
    "googleapis": "^118.0.0",
    "inquirer": "^8.2.5",
    "open": "^9.0.0",
    "openai": "^4.0.0",
    "simple-oauth2": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.10.6",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
